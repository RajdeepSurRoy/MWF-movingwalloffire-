# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# The firewall uses no generative LLM, so there is no AI provider key here.
# The shopping agent's and red-team generator's model is not decided yet.

# --- PayPal Sandbox ---
# From https://developer.paypal.com → Apps & Credentials (Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Set after registering a sandbox webhook; used to verify webhook signatures
PAYPAL_WEBHOOK_ID=

# --- MWF firewall (local) ---
# SQLite file for keys, sessions and the ledger (relative to apps/firewall-api)
MWF_DB_PATH=data/mwf.db
# Your own local key: create it with `npm run keys:create -- <tenant>`. Each developer
# makes their own; keys are stored hashed in your local database and never shared.
MWF_API_KEY=
