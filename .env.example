# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# --- Gemini (Google AI Studio, free tier) ---
# Create a key at https://aistudio.google.com/api-keys
GEMINI_API_KEY=
# Pinned version (not -latest) so behaviour doesn't change mid-hackathon. See docs/llm-budget.md
GEMINI_MODEL=gemini-3.5-flash
# replay = cache only (default, no API calls) | record = call on cache miss | live = always call
LLM_MODE=replay

# --- PayPal Sandbox ---
# From https://developer.paypal.com → Apps & Credentials (Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Set after registering a sandbox webhook; used to verify webhook signatures
PAYPAL_WEBHOOK_ID=
