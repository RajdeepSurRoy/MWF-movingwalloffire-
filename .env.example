# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# --- Gemini (Google AI Studio, free tier) ---
# Create a key at https://aistudio.google.com/api-keys
GEMINI_API_KEY=
# Pick a Flash-class model your key has access to (check the Rate Limit page in AI Studio)
GEMINI_MODEL=

# --- PayPal Sandbox ---
# From https://developer.paypal.com → Apps & Credentials (Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Set after registering a sandbox webhook; used to verify webhook signatures
PAYPAL_WEBHOOK_ID=
