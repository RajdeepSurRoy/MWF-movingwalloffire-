# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# The firewall uses no generative LLM, so there is no AI provider key here.
# PayPal credentials belong to the integrating business's app (e.g. Errand), never here.

# --- MWF firewall (local) ---
# SQLite file for keys, sessions and the ledger (relative to apps/firewall-api)
MWF_DB_PATH=data/mwf.db
# Render pages in headless Chromium at /v1/context/inspect (on unless set to off).
MWF_RENDER=on
# Chromium's OS sandbox for that render. Leave on; set off only on a host that cannot provide it.
MWF_RENDER_SANDBOX=on
# Your own local key: create it with `npm run keys:create -- <tenant>`. Each developer
# makes their own; keys are stored hashed in your local database and never shared.
MWF_API_KEY=
