# Copy this file to .env and fill in the values. Never commit .env.

# Required. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: the model, and a second model to use when the first hits its free limit.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: most AI requests per minute (keep it under your free-tier limit).
GEMINI_RPM=8

# The shop the agent orders from (the FreshCart demo store).
STORE_URL=http://localhost:3000

# Which installed browser the agent drives: chrome or msedge.
BROWSER_CHANNEL=chrome

# Set to 1 to see the agent's real browser window on screen.
HEADED=0

# Pause between browser steps (ms), so the live view is easy to follow.
STEP_DELAY_MS=250

# Port for this app.
PORT=4000

# ---- Saving the free-tier quota ----
# "gemini" for the real AI, "mock" for an offline stand-in (no API calls, for UI and flow tests).
AGENT_LLM=gemini

# Identical AI requests reuse a saved answer for this many hours (0 = off, e.g. for live exploit tests).
LLM_CACHE_HOURS=72

# Walk the store's aisles once up front so a suggestion takes 1 AI request (0 = search instead).
PREFETCH_CATALOG=1

# Requests per day the app allows itself per model (0 = no local limit).
GEMINI_DAILY_LIMIT=20
GEMINI_FALLBACK_DAILY_LIMIT=0

# ---- The agent's PayPal wallet (sandbox) ----
# A PayPal sandbox *personal* account (developer.paypal.com > Testing Tools > Sandbox Accounts).
# When a shop's checkout offers PayPal, the agent logs in to this account on sandbox.paypal.com and pays.
# Use only a sandbox test account, never a real PayPal login.
PAYPAL_BUYER_EMAIL=
PAYPAL_BUYER_PASSWORD=
# auto = PayPal when the shop offers it, otherwise the shop's own option; paypal = PayPal only; off = never
WALLET_MODE=auto
# Extra hosts the wallet may log in on (comma-separated), for local test pages only
WALLET_EXTRA_HOSTS=

# ---- MWF agent firewall (optional) ----
# Errand calls the firewall over its HTTP API. With it on, every FreshCart page is checked before
# the AI reads it, and every payment is checked and committed before the order is placed.
# Get a key from the firewall project: npm run keys:create -- errand
# and register FreshCart there: npm run merchants:add -- errand freshcart FreshCart http://localhost:3000
MWF_ENABLED=0
MWF_API_URL=http://127.0.0.1:8787
MWF_API_KEY=
MWF_MERCHANT_ID=freshcart
# Most a shop may charge on top of the items (delivery). FreshCart's is $4.99.
MWF_MAX_FEE=4.99
