{
  "name": "errand-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A third-party AI shopping agent that browses and orders from the FreshCart demo store for you.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "try": "tsx scripts/try-agent.ts",
    "test:wallet": "tsx scripts/test-wallet.ts paypal && tsx scripts/test-wallet.ts off"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "openai": "^7.45.1",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
