# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Required for the shopping assistant. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: the model, and a second model to use when the first hits its free limit.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: most AI requests the whole server sends per minute (keep it under your free-tier limit).
GEMINI_RPM=8

# Optional: where the SQLite database file lives (default: ./data/freshcart.db)
# DATABASE_PATH=./data/freshcart.db

# Optional: PayPal sandbox checkout. From https://developer.paypal.com > Apps & Credentials (Sandbox).
# Sandbox only: this demo never talks to PayPal's live API. Leave empty to hide the PayPal option.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: the store's public address, used for PayPal's return links (default: taken from the request).
# APP_URL=http://localhost:3000

# Optional: the MWF agent firewall guards the shopping assistant over its HTTP API: seller text
# is checked before the assistant reads it, and orders it takes are checked before they're placed.
# Key: in the firewall project, npm run keys:create -- freshcart
# then: npm run merchants:add -- freshcart freshcart FreshCart http://localhost:3000
MWF_ENABLED=0
MWF_API_URL=http://127.0.0.1:8787
MWF_API_KEY=
MWF_MERCHANT_ID=freshcart
# FreshCart's own PayPal (sandbox business) account email. With MWF on, every PayPal payment is
# checked before capture: PayPal's API must say the order pays this account, for the order's amount.
# Register the same email with MWF: npm run merchants:add -- freshcart freshcart FreshCart <this email> http://localhost:3000
MWF_PAYPAL_PAYEE=
# One chat's spending limit across all its orders, in dollars.
MWF_SESSION_BUDGET=200
# Test switch for the attack lab only: renders product descriptions as HTML. Never in production.
ATTACK_RAW_HTML=0
