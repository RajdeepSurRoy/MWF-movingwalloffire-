{
  "name": "mwf",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tests"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "dev:api": "npm run dev -w @mwf/firewall-api",
    "keys:create": "npm run cli -w @mwf/firewall-api -- keys:create",
    "ledger:verify": "npm run cli -w @mwf/firewall-api -- ledger:verify",
    "harness": "npm run harness -w @mwf/tests",
    "merchants:add": "npm run cli -w @mwf/firewall-api -- merchants:add"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
